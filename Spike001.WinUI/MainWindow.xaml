<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Spike001.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Spike001.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Spike001.WinUI">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout" RowDefinitions="Auto,*">
        <StackPanel
            Padding="12"
            Orientation="Horizontal"
            Spacing="8">
            <Button Content="Inicio" Command="{Binding NavigateHomeCommand}" />
            <Button Content="Plataforma" Command="{Binding NavigatePlatformCommand}" />
            <Button Content="Pruebas" Command="{Binding NavigateTestsCommand}" />
        </StackPanel>

        <Frame x:Name="ContentFrame" Grid.Row="1" />
    </Grid>
</Window>
