<Page
    x:Class="Spike001.WinUI.Views.PlatformPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="32" Spacing="12">
        <TextBlock Text="{Binding ViewName}" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Purpose}" TextWrapping="Wrap" />
    </StackPanel>
</Page>
